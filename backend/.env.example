# --- Server ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma separated list of allowed browser origins for CORS
CORS_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL 14+) ---
DATABASE_URL=postgres://jain:jain@localhost:5432/jain_distributor

# --- Auth ---
# Must be at least 32 characters in production. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-min
JWT_EXPIRES_IN=7d

# Bootstrap admin: created on startup only if no ADMIN user exists yet.
ADMIN_EMAIL=admin@jain.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=प्रशासक

# --- Marathi speech-to-text ---
# "mock" returns MOCK_TRANSCRIPT (for development / demos); "google" calls Google Cloud Speech-to-Text.
STT_PROVIDER=mock
STT_LANGUAGE=mr-IN
GOOGLE_SPEECH_API_KEY=
# Accuracy tuning (defaults are recommended): model, phrase-hint boost, extra words to boost
# (comma separated, e.g. local brand names), extra languages, and the confidence below which the
# app asks the salesperson to check the transcript.
STT_MODEL=latest_long
STT_PHRASE_BOOST=12
STT_EXTRA_PHRASES=
STT_ALTERNATIVE_LANGUAGES=
STT_MIN_CONFIDENCE=0.7
MOCK_TRANSCRIPT=दहा किलो रवा, पार्ले बिस्किट वीस पॅकेट, पन्नास किलो गूळ आणि डाबर टूथपेस्ट पाच बॉक्स.
MAX_AUDIO_MB=10

# Business timezone offset in minutes from UTC, used for "today" in dashboards (IST = 330)
BUSINESS_TZ_OFFSET_MINUTES=330
