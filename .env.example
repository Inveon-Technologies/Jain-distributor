# Used by docker-compose.yml. Copy to .env and change the secrets before deploying.

POSTGRES_DB=jain_distributor
POSTGRES_USER=jain
POSTGRES_PASSWORD=change-me

# openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# First admin account (created on first start only)
ADMIN_EMAIL=admin@jain.com
ADMIN_PASSWORD=

# Browser origins allowed to call the API, and the API URL baked into the web build
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Marathi speech-to-text: mock | google
STT_PROVIDER=mock
GOOGLE_SPEECH_API_KEY=

# Host ports
WEB_PORT=3000
API_PORT=4000
DB_PORT=5432

# Images (set by the deploy pipeline to ghcr.io/<owner>/<repo>-api:<tag> etc.)
# API_IMAGE=
# WEB_IMAGE=
