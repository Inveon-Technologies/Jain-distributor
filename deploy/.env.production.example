# Copy to /opt/jain-distributor/.env on the server (chmod 600) and fill in every empty value.
# Generate secrets with: openssl rand -hex 32

# --- Domain / HTTPS ---
# DNS A records for DOMAIN and www.DOMAIN must point at this server before the first start.
# To run on the bare IP over plain HTTP before DNS is ready, use DOMAIN=:80 (see deploy/README.md).
DOMAIN=jaindistributor.in
# Let's Encrypt expiry notices go here
ACME_EMAIL=

# --- Images (the release workflow sets these on every deploy; set them for manual starts) ---
# Images built on the server with `docker compose build` are jain-distributor-api:local / -web:local.
API_IMAGE=ghcr.io/inveon-technologies/jain-distributor-api:latest
WEB_IMAGE=ghcr.io/inveon-technologies/jain-distributor-web:latest

# --- Database ---
POSTGRES_DB=jain_distributor
POSTGRES_USER=jain
POSTGRES_PASSWORD=

# --- Auth ---
JWT_SECRET=
JWT_EXPIRES_IN=7d

# First admin account (created on first start only, if no admin exists yet)
ADMIN_EMAIL=admin@jaindistributor.in
ADMIN_PASSWORD=
ADMIN_NAME=प्रशासक

# Browser origins allowed to call the API. Defaults to https://$DOMAIN,https://www.$DOMAIN when left unset.
# CORS_ORIGINS=https://jaindistributor.in,https://www.jaindistributor.in

# --- Marathi speech-to-text: google | mock ---
STT_PROVIDER=google
STT_LANGUAGE=mr-IN
GOOGLE_SPEECH_API_KEY=
MAX_AUDIO_MB=10

# --- Misc ---
LOG_LEVEL=info
# IST = 330
BUSINESS_TZ_OFFSET_MINUTES=330
